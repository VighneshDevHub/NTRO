# Copy this file to .env in the repo root before running `docker compose up`.
# Never commit the real .env.

### Postgres ###
POSTGRES_USER=forensicguard
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=forensicguard

### Backend auth ###
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-real-random-secret

### Backend certificate/report signing (ECDSA keypair) ###
# OPTIONAL — if left blank, the backend auto-generates a keypair on
# first run and persists it into the `keys_data` Docker volume, which
# survives `docker compose down && up` (not just a plain restart).
# This is sufficient for a demo/hackathon deployment.
#
# For a real production deployment, generate a real keypair yourself
# and inject it here from a proper secrets manager instead:
#   cd backend && python -c "
#   from app.core.crypto import generate_keypair
#   priv, pub = generate_keypair()
#   print('SIGNING_PRIVATE_KEY_PEM=' + priv.replace(chr(10), '\\n'))
#   print('SIGNING_PUBLIC_KEY_PEM=' + pub.replace(chr(10), '\\n'))
#   "
SIGNING_PRIVATE_KEY_PEM=
SIGNING_PUBLIC_KEY_PEM=

### Public URLs ###
# Must be reachable from the BROWSER, not Docker-internal hostnames.
PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
